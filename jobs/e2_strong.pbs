#!/bin/bash
#PBS -P personal-e0969079
#PBS -q auto_free
#PBS -N e2_strong
#PBS -l select=1:ncpus=32:mpiprocs=32:mem=16gb:node_pool=cpu_free
#PBS -l walltime=02:00:00
#PBS -j oe

### E2: strong scaling (guidelines §6). Fixed 8192^2 grid, cores 1, 2, 4, ... up to the allocation.
### V0 baseline, V1 (threads), V2 (ranks), V3 (4 threads per rank); 5 repetitions each.
### Submit from the repo root after building:
###   32 cores (default):  qsub jobs/e2_strong.pbs
###   whole node (64):     qsub -l select=1:ncpus=64:mpiprocs=64:mem=16gb:node_pool=cpu_free jobs/e2_strong.pbs
cd "$PBS_O_WORKDIR"
[ -f scripts/job_common.sh ] || { echo "ERROR: scripts/job_common.sh missing - upload it first"; exit 1; }
source scripts/job_common.sh

NX=${NX:-8192}
ITERS=${ITERS:-1000}
REPS=${REPS:-5}
HT=${HT:-4}   # threads per rank for V3
OUT=${OUT:-results/raw/e2_strong_${NCORES}c.csv}
csv_init "$OUT"
echo "== grid ${NX}^2, $ITERS iterations, cores: $(pow2_upto $NCORES) -> $OUT"

echo "== V0 baseline"
for rep in $(seq $REPS); do
    ./build/v0_serial --nx $NX --ny $NX --iters $ITERS | tag | tee -a "$OUT"
done

for P in $(pow2_upto $NCORES); do
    echo "== $P cores"
    for rep in $(seq $REPS); do
        OMP_NUM_THREADS=$P ./build/v1_openmp --nx $NX --ny $NX --iters $ITERS | tag | tee -a "$OUT"
        run_mpi $P 1 ./build/v2_mpi --nx $NX --ny $NX --iters $ITERS | tag | tee -a "$OUT"
        if [ $P -ge $HT ]; then
            run_mpi $((P / HT)) $HT ./build/v3_hybrid --nx $NX --ny $NX --iters $ITERS | tag | tee -a "$OUT"
        fi
    done
done
echo "== done"
